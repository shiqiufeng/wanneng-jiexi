                    "browser_fallback": {
                        "description": "浏览器兜底（强烈建议开启）",
                        "hint": "抖音自 2026-09 起对「主页作品」「作品详情」接口启用 Argus 风控，纯 HTTP 请求一律返回 403（表现为「/全部」「/全部音乐」报 403、实况退化成静态图）。开启后用真实浏览器页面代发请求绕过。需先安装：pip install playwright（复用系统 Edge/Chrome 无需再下载浏览器）。关闭后上述功能将不可用。",
                        "type": "bool",
                        "default": true
                    },
                    "browser_channel": {
                        "description": "浏览器通道",
                        "hint": "auto（推荐）= 按平台自动选：Windows 试 Edge→Chrome，Linux 试 Chrome→自带 Chromium。也可显式填 msedge / chrome / chromium，或 executable:/usr/bin/google-chrome 指定可执行文件。Linux 服务器上没有 Edge，必须先把自带内核装上：python -m playwright install --with-deps chromium。",
                        "type": "string",
                        "default": "auto"
                    },
                    "browser_headless": {
                        "description": "浏览器无头模式",
                        "hint": "开启后浏览器在后台静默运行。服务器环境建议保持开启；若仍被风控可尝试关闭（需带桌面环境）。",
                        "type": "bool",
                        "default": true
                    },
                    "browser_idle_timeout": {
                        "description": "浏览器空闲自动关闭（秒）",
                        "hint": "浏览器空闲超过该时长后自动关闭以释放内存，下次请求时自动重启。设为 0 表示不自动关闭。",
                        "type": "int",
