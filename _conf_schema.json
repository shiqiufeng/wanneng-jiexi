                        "labels": [
                            "360P 流畅",
                            "480P 标清",
                            "720P 高清",
                            "1080P 全高清",
                            "1080P+ 增强版",
                            "1080P 60帧",
                            "4K 超高清",
                            "HDR 高动态范围",
                            "杜比视界 Dolby Vision",
                            "8K 超高清",
                            "AI修复"
                        ],
                        "default": "_720P"
                    }
                }
            },
            "douyin": {
                "name": "抖音解析器",
